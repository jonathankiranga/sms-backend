# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_strong_db_password
DB_NAME=your_database
DB_SSL=true
# DB_SSL_CA=./ca.pem

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=https://yourdomain.com,http://localhost:5173

# Session / Auth
SESSION_SECRET=generate_a_random_64_char_secret_here
ADMIN_PASSWORD=your_strong_admin_password
MIGRATE_SECRET=your_strong_migrate_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# M-Pesa (Daraja)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_ENVIRONMENT=sandbox

# Base URL for M-Pesa callbacks (must be public HTTPS)
BASE_URL=https://your-backend.onrender.com

# WhatsApp / Meta
META_ACCESS_TOKEN=your_meta_token
PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_TEMPLATE_ABSENCE=absence_alert
WHATSAPP_TEMPLATE_OTP=otp_verification
WHATSAPP_TEMPLATE_ASSESSMENT=assessment_result
WHATSAPP_TEMPLATE_FEE=fee_reminder
WHATSAPP_TEMPLATE_BROADCAST=school_broadcast
WHATSAPP_TEMPLATE_CONSEC_ABSENCE=consecutive_absence

# Africa's Talking SMS (optional fallback)
AT_API_KEY=your_at_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=

# Migrations
RUN_MIGRATIONS=false
MIGRATE_ALLOW_PROD=false
